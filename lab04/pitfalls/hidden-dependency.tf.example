# ใช้เป็นตัวอย่างเท่านั้น: เติมใน root module เมื่อทดลอง Pitfall D
resource "aws_dynamodb_table" "demo" {
  name         = "${local.name_prefix}-demo"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "id"

  attribute {
    name = "id"
    type = "S"
  }
}

resource "aws_dynamodb_table_item" "seed" {
  table_name = aws_dynamodb_table.demo.name
  hash_key   = aws_dynamodb_table.demo.hash_key
  item       = jsonencode({ id = { S = "seed" } })
}
