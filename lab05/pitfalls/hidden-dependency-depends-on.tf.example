# Pitfall D - fix 1: explicit depends_on (works, but not preferred)
resource "aws_dynamodb_table" "demo" {
  name         = "${local.name_prefix}-demo"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "id"

  attribute {
    name = "id"
    type = "S"
  }
}

resource "aws_dynamodb_table_item" "seed" {
  depends_on = [aws_dynamodb_table.demo]

  table_name = "${local.name_prefix}-demo"
  hash_key   = "id"
  item       = jsonencode({ id = { S = "seed" } })
}
